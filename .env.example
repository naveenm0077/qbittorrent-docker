QBIT_API_KEY=replace_with_your_qbittorrent_webui_api_key

# Optional. Host folder mounted as /downloads in the container.
# Default: ~/Downloads/qbittorrent-downloads
# After changing this, run qb start (remounts if needed) or qb repair.
# QB_DOWNLOADS=/path/to/your/downloads

# Optional. CLI output style: bare | color | emoji
# bare  = ✓ / X / ■ (no color); plain braille spinner
# color = same marks + ANSI color (default; like gh); green braille spinner
# emoji = ✅ ❌ 🛑 ➡️ ↗️; moon-phase spinner
# Default: color
# QB_STYLE=emoji

# Optional. Where Docker publishes the WebUI on the Mac.
# localhost = this machine only (127.0.0.1:8080)
# lan       = all interfaces (0.0.0.0:8080), allowing LAN access
# Default: localhost
# After changing, run: qb start   (or qb repair)
# QB_WEBUI_BIND=lan

# Optional. What qb quit does with Docker Desktop when no other containers are running.
# stop = stop Docker Desktop too (default)
# keep = leave Docker Desktop running (qBittorrent only)
# Default: stop
# QB_QUIT_DOCKER=keep
